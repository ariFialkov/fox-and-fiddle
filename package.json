{
  "name": "fox-and-fiddle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fox and Fiddle - a first-person dive-bar betting game (PWA)",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"vite\"",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/make-icons.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
